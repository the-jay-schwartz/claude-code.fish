#!/usr/bin/env fish
# Fake claude CLI: logs args, records stdin, prints a canned reply.
# `auth` calls are logged to $CCF_STUB_AUTH_LOG only; while the
# $CCF_STUB_LOGGED_OUT file exists every other call fails with the login hint.
if test "$argv[1]" = auth
    switch "$argv[2]"
        case status
            test -n "$CCF_STUB_AUTH_LOG"; and echo status >>$CCF_STUB_AUTH_LOG
            if test -n "$CCF_STUB_LOGGED_OUT"; and test -e "$CCF_STUB_LOGGED_OUT"
                echo '{"loggedIn": false}'
                exit 1
            end
            echo '{"loggedIn": true}'
            exit 0
        case login
            test -n "$CCF_STUB_AUTH_LOG"; and echo login >>$CCF_STUB_AUTH_LOG
            test "$CCF_STUB_LOGIN_OK" = 1; and test -n "$CCF_STUB_LOGGED_OUT"; and rm -f $CCF_STUB_LOGGED_OUT
            exit 0
    end
end
for a in $argv
    echo -- $a >>$CCF_STUB_LOG
end
if test -n "$CCF_STUB_LOGGED_OUT"; and test -e "$CCF_STUB_LOGGED_OUT"
    echo 'Not logged in · Please run /login'
    exit 1
end
if test -n "$CCF_STUB_STDIN"; and not isatty stdin
    cat >$CCF_STUB_STDIN
end
test -n "$CCF_STUB_REPLY"; and echo $CCF_STUB_REPLY
exit (test -n "$CCF_STUB_EXIT"; and echo $CCF_STUB_EXIT; or echo 0)
